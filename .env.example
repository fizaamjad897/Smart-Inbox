# Root .env — read automatically by docker-compose for variable substitution.
# Copy to .env only if you want to override defaults. .env is git-ignored.
#
# By default the backend container talks to the bundled `mongo` service, so
# you can leave this file empty. To use MongoDB Atlas instead, uncomment:
#
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=smartinbox
