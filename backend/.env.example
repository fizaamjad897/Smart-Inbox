# Copy to .env and fill in.  .env is git-ignored.

# --- MongoDB ---
# Local (running your own mongod):      mongodb://localhost:27017
# Docker Compose (bundled container):   mongodb://mongo:27017
# MongoDB Atlas (free cloud tier):      mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=smartinbox

# Port the API listens on.
PORT=4000

# --- Auth ---
# Secret used to sign login tokens (JWT). Use a long random string in prod.
JWT_SECRET=change-me-to-a-long-random-string

# --- Classification ---
# Groq API key. If omitted, classification falls back to keyword matching so
# the demo still works. Get one at https://console.groq.com
GROQ_API_KEY=

# --- Demo account (created by `npm run seed`) ---
DEMO_EMAIL=demo@smartinbox.app
DEMO_PASSWORD=demo1234

# --- Live ingestion ---
# The account that the n8n workflow's real emails are stored under.
# Sign up in the app with this email; n8n POSTs then land in that account.
# Defaults to DEMO_EMAIL if unset.
INGEST_EMAIL=demo@smartinbox.app
