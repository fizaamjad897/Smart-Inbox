# Copy to .env on the server:  cp .env.example .env  then edit.

# Your free DuckDNS subdomain, pointed at this EC2's public IP.
N8N_HOST=yourname.duckdns.org

# A long random secret. Generate with:  openssl rand -hex 24
# Keep it constant forever, or saved credentials can't be decrypted.
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-24
