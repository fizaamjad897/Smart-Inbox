      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst clean = (str) => String(str || '').replace(/[\\u0000-\\u001F]/g, ' ').trim();\nconst subject = clean(item.Subject || item.subject || '(No Subject)').substring(0, 200);\nconst from = clean(item.From || item.from || 'Unknown').substring(0, 200);\nconst snippet = clean(item.snippet || '').substring(0, 500);\nreturn [{ json: { subject, from, snippet, messageId: item.id, threadId: item.threadId, timestamp: new Date().toLocaleString('en-PK', { timeZone: 'Asia/Karachi' }) } }];"
      },
