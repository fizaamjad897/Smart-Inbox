        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({model:'llama-3.3-70b-versatile',max_tokens:20,temperature:0,messages:[{role:'system',content:'Classify email. Return ONE WORD only: URGENT LEAD SUPPORT NEWSLETTER OTHER\\n\\nURGENT: server down/crash/critical/emergency/outage/immediately\\nLEAD: interested/hire/pricing/demo/budget/partnership/schedule\\nSUPPORT: help/password/login/account/bug/troubleshoot\\nNEWSLETTER: promo/marketing/discount/unsubscribe\\nOTHER: everything else\\n\\nExamples:\\nServer Down -> URGENT\\nInterested in hiring -> LEAD\\nForgot password -> SUPPORT\\nNewsletter -> NEWSLETTER'},{role:'user',content:'Subject: '+$json.subject+' Body: '+$json.snippet}]}) }}",
        "options": {}
