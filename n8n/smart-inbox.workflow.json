    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst raw = response.choices[0].message.content.trim().toUpperCase();\nconst valid = ['URGENT', 'LEAD', 'SUPPORT', 'NEWSLETTER', 'OTHER'];\nconst category = valid.find(c => raw.includes(c)) || 'OTHER';\nconst prev = $('Normalize Fields').first().json;\nreturn [{ json: { ...prev, category } }];"
      },
