        "jsCode": "const response = $input.first().json;\nconst raw = response.choices[0].message.content.trim();\nlet lead;\ntry {\n  lead = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch(e) {\n  lead = { company_name: 'Unknown', sender_name: 'Unknown', interest_level: 'cold', estimated_value: 'low', summary: 'Could not parse' };\n}\nconst prev = $('Normalize Fields').first().json;\nreturn [{ json: { ...prev, ...lead } }];"
